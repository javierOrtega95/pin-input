{
  "name": "@javierortega95/pin-input",
  "version": "0.2.0",
  "description": "A headless, accessible PIN/OTP input web component. Framework-agnostic, zero dependencies, with native form participation.",
  "type": "module",
  "keywords": [
    "web-component",
    "pin-input",
    "otp",
    "2fa",
    "headless",
    "accessible"
  ],
  "author": "Javier Ortega Carrasco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javierOrtega95/pin-input.git"
  },
  "homepage": "https://javierortega95.github.io/pin-input",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/pin-input.umd.cjs",
  "module": "./dist/pin-input.js",
  "types": "./dist/types/pin-input.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pin-input.js",
      "require": "./dist/pin-input.umd.cjs",
      "types": "./dist/types/pin-input.d.ts"
    }
  },
  "files": [
    "dist",
    "custom-elements.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "customElements": "custom-elements.json",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly && cem analyze --globs src/pin-input.ts",
    "preview": "vite preview",
    "test": "vitest",
    "analyze": "cem analyze --globs src/pin-input.ts"
  },
  "pnpm": {
    "overrides": {
      "flatted": "^3.4.2",
      "picomatch@^4.0.0": "^4.0.4"
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@vitest/browser-playwright": "^4.1.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.1"
  }
}